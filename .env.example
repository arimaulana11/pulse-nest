# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Production (Neon): set DATABASE_URL
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Local dev: set individual DB_* vars (ignored when DATABASE_URL is set)
DB_HOST=localhost
DB_PORT=5432
DB_USER=pulse_user
DB_PASS=pulse_secret
DB_NAME=pulse_db

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_min_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# ── Google Sheets ─────────────────────────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your_google_sheet_id

SHEET_TRANSACTIONS=transactions
SHEET_BUDGET=budget_positions
SHEET_JOURNEY=journey_progress
SHEET_GOALS=goals

# ── Email ─────────────────────────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your@gmail.com
MAIL_PASS=your_gmail_app_password
MAIL_FROM="Pulse App <your@gmail.com>"

# ── App ───────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=production
FRONTEND_URL=https://your-pulse-next.vercel.app
DASHBOARD_ADMIN_URL=https://your-pulse-admin.vercel.app
