{
  "version": 2,
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "dist/**",
          "src/**",
          "node_modules/pg/**",
          "node_modules/pg-pool/**",
          "node_modules/pg-protocol/**",
          "node_modules/pg-types/**",
          "node_modules/pgpass/**",
          "node_modules/ws/**",
          "node_modules/@neondatabase/**"
        ],
        "tsconfig": "tsconfig.vercel.json",
        "maxDuration": 30
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.ts"
    }
  ]
}
